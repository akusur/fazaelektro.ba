---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjektPost from '../../layouts/ProjektPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('projekti');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'projekti'>;

const post = Astro.props;
const { Content } = await render(post);
---

<ProjektPost {...post.data}>
	<Content />
</ProjektPost>
