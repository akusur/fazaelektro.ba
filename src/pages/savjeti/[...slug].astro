---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SavjetPost from '../../layouts/SavjetPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('savjeti');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'savjeti'>;

const post = Astro.props;
const { Content } = await render(post);
---

<SavjetPost {...post.data}>
	<Content />
</SavjetPost>
