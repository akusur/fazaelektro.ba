---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'savjeti'>['data'];

const { title, description, imageUrl, imageAlt } = Astro.props;
---

<html lang="bs">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.article-image {
				width: 100%;
				max-height: 520px;
				margin: 0 auto 2rem;
				object-fit: cover;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<hr />
					</div>
					<img class="article-image" src={imageUrl} alt={imageAlt} fetchpriority="high" />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
