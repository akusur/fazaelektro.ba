    <!-- Interactive Client Script -->
    <script is:inline>
      // Default Items Presets
      const PRESETS = {
        stan: [
          { desc: 'Štemanje zidova i polaganje kablova (NYM-J 3x1.5mm² i 3x2.5mm²)', unit: 'm', qty: 150, price: 6.50, disc: 0 },
          { desc: 'Montaža i povezivanje ugradbenih razvodnih kutija (doza Ø60/Ø78)', unit: 'kom', qty: 45, price: 8.00, disc: 0 },
          { desc: 'Isporuka, ugradnja i šemiranje razvodnog ormara (24M) sa FID sklopkom i 14 aut. osigurača', unit: 'paušal', qty: 1, price: 420.00, disc: 0 },
          { desc: 'Fina montaža utičnica, prekidača i rasvjetnih tijela sa spajanjem', unit: 'kom', qty: 55, price: 9.00, disc: 0 },
          { desc: 'Ispitivanje strujnih krugova, mjerenje otpora izolacije i puštanje u rad', unit: 'paušal', qty: 1, price: 150.00, disc: 0 }
        ],
        ormar: [
          { desc: 'Ugradbeni razvodni ormar 36 modula sa vratima', unit: 'kom', qty: 1, price: 110.00, disc: 0 },
          { desc: 'Glavna FID sklopka 40A / 0.03A 4p', unit: 'kom', qty: 1, price: 85.00, disc: 0 },
          { desc: 'Automatski osigurači 16A (B/C karakteristika)', unit: 'kom', qty: 18, price: 9.50, disc: 0 },
          { desc: 'Automatski osigurači 10A (B karakteristika)', unit: 'kom', qty: 8, price: 9.50, disc: 0 },
          { desc: 'Montaža, šemiranje ormara i označavanje krugova', unit: 'paušal', qty: 1, price: 250.00, disc: 0 }
        ],
        fina: [
          { desc: 'Montaža standardnih ŠUKO dvostrukih/jednostrukih utičnica', unit: 'kom', qty: 30, price: 8.50, disc: 0 },
          { desc: 'Montaža naizmjeničnih i serijskih prekidača', unit: 'kom', qty: 14, price: 9.00, disc: 0 },
          { desc: 'Montaža ugradbenih LED panela 18W/24W', unit: 'kom', qty: 12, price: 18.00, disc: 0 },
          { desc: 'Montaža i spajanje dekorativnih lustera i zidnih lampi', unit: 'kom', qty: 6, price: 25.00, disc: 0 }
        ],
        gromobran: [
          { desc: 'Polaganje pocinkovane trake FeZn 25x4mm u rov/temelj', unit: 'm', qty: 50, price: 12.00, disc: 0 },
          { desc: 'Montaža mjerne kutije gromobrana sa ukrsnim komadima', unit: 'kom', qty: 4, price: 45.00, disc: 0 },
          { desc: 'Mjerenje otpora rasprostiranja uzemljenja sa izradom zapisnika', unit: 'paušal', qty: 1, price: 180.00, disc: 0 }
        ],
        prazno: []
      };

      // Current active items array
      let items = [...PRESETS.stan];

      // Helper: Format currency
      function formatMoney(amount) {
        return amount.toLocaleString('bs-BA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' KM';
      }

      // Convert Number to Bosnian words for currency
      function numberToWordsBS(n) {
        const units = ['', 'jedna', 'dvije', 'tri', 'četiri', 'pet', 'šest', 'sedam', 'osam', 'devet'];
        const tens = ['', 'deset', 'dvadeset', 'trideset', 'četrdeset', 'pedeset', 'šezdeset', 'sedamdeset', 'osamdeset', 'devedeset'];
        const teens = ['deset', 'jedanaest', 'dvanaest', 'trinaest', 'četrnaest', 'petnaest', 'šesnaest', 'sedamnaest', 'osamnaest', 'devetnaest'];
        const hundreds = ['', 'sto', 'dvjesto', 'tristo', 'četiri stotine', 'petsto', 'šeststo', 'sedamsto', 'osamsto', 'devetsto'];

        const intPart = Math.floor(n);
        const decPart = Math.round((n - intPart) * 100);

        if (intPart === 0) return `Nula KM i ${decPart < 10 ? '0' + decPart : decPart}/100`;

        function convertGroup(num) {
          let str = '';
          const h = Math.floor(num / 100);
          const t = Math.floor((num % 100) / 10);
          const u = num % 10;

          if (h > 0) str += hundreds[h] + ' ';
          if (t === 1) {
            str += teens[u] + ' ';
          } else {
            if (t > 0) str += tens[t] + ' ';
            if (u > 0) str += units[u] + ' ';
          }
          return str.trim();
        }

        let result = '';
        const thousands = Math.floor(intPart / 1000);
        const remainder = intPart % 1000;

        if (thousands > 0) {
          if (thousands === 1) result += 'Jedna hiljada ';
          else if (thousands >= 2 && thousands <= 4) result += convertGroup(thousands) + ' hiljade ';
          else result += convertGroup(thousands) + ' hiljada ';
        }

        if (remainder > 0) {
          result += convertGroup(remainder) + ' ';
        }

        result = result.trim();
        result = result.charAt(0).toUpperCase() + result.slice(1);
        return `${result} KM i ${decPart < 10 ? '0' + decPart : decPart}/100`;
      }

      // Render items table
      function renderItems() {
        const tbody = document.getElementById('items-body');
        if (!tbody) return;
        tbody.innerHTML = '';

        let subtotal = 0;

        items.forEach((item, index) => {
          const qty = parseFloat(item.qty) || 0;
          const price = parseFloat(item.price) || 0;
          const disc = parseFloat(item.disc) || 0;

          const lineSubtotal = qty * price;
          const lineTotal = lineSubtotal * (1 - disc / 100);
          subtotal += lineTotal;

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="col-num">${index + 1}</td>
            <td class="col-desc">
              <textarea class="editable-field item-field" data-index="${index}" data-prop="desc">${item.desc}</textarea>
            </td>
            <td class="col-unit">
              <input type="text" class="editable-field text-center item-field" data-index="${index}" data-prop="unit" value="${item.unit}" />
            </td>
            <td class="col-qty">
              <input type="number" step="any" class="editable-field text-right item-field" data-index="${index}" data-prop="qty" value="${item.qty}" />
            </td>
            <td class="col-price">
              <input type="number" step="0.01" class="editable-field text-right item-field" data-index="${index}" data-prop="price" value="${item.price}" />
            </td>
            <td class="col-disc">
              <input type="number" step="1" min="0" max="100" class="editable-field text-right item-field" data-index="${index}" data-prop="disc" value="${item.disc}" />
            </td>
            <td class="col-total text-right">${formatMoney(lineTotal)}</td>
            <td class="col-actions no-print text-center">
              <button type="button" class="btn-icon-danger btn-delete-item" data-index="${index}" title="Obriši stavku">🗑️</button>
            </td>
          `;
          tbody.appendChild(tr);
        });

        // Calculate Totals
        const vatRate = parseFloat(document.getElementById('vat-rate-select').value) || 0;
        const vatAmount = subtotal * (vatRate / 100);
        const grandTotal = subtotal + vatAmount;

        document.getElementById('subtotal-val').innerText = formatMoney(subtotal);
        document.getElementById('vat-val').innerText = formatMoney(vatAmount);
        document.getElementById('grand-total-val').innerText = formatMoney(grandTotal);

        // Update VAT Label for print
        const vatLabel = vatRate > 0 ? `PDV (${vatRate}%):` : 'Bez PDV-a:';
        document.getElementById('vat-label-print').innerText = vatLabel;

        // Words
        document.getElementById('words-total-text').innerText = numberToWordsBS(grandTotal);

        // Synchronize quote reference in bank card
        const qNum = document.getElementById('quote-number').value;
        document.getElementById('bank-reference').value = qNum;
        document.getElementById('print-quote-number').innerText = qNum;

        // Auto save to current draft in localStorage
        saveToLocalStorageCurrent();
      }

      // Add item
      document.getElementById('btn-add-row')?.addEventListener('click', () => {
        items.push({
          desc: 'Nova stavka radova ili materijala',
          unit: 'kom',
          qty: 1,
          price: 0,
          disc: 0
        });
        renderItems();
      });

      // Item field edit & delete delegated listener
      document.getElementById('items-body')?.addEventListener('input', (e) => {
        const target = e.target;
        if (target.classList.contains('item-field')) {
          const index = parseInt(target.dataset.index);
          const prop = target.dataset.prop;
          let val = target.value;
          if (prop === 'qty' || prop === 'price' || prop === 'disc') {
            val = parseFloat(val) || 0;
          }
          items[index][prop] = val;
          renderItems();
        }
      });

      document.getElementById('items-body')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.btn-delete-item');
        if (btn) {
          const index = parseInt(btn.dataset.index);
          items.splice(index, 1);
          renderItems();
        }
      });

      // VAT Select listener
      document.getElementById('vat-rate-select')?.addEventListener('change', renderItems);

      // Quote Number input listener syncs bank reference
      document.getElementById('quote-number')?.addEventListener('input', (e) => {
        document.getElementById('bank-reference').value = e.target.value;
        document.getElementById('print-quote-number').innerText = e.target.value;
        saveToLocalStorageCurrent();
      });

      // Listen on all inputs for auto-save
      document.querySelectorAll('.editable-field').forEach(input => {
        input.addEventListener('input', saveToLocalStorageCurrent);
      });

      // Load Preset
      document.querySelectorAll('[data-preset]').forEach(button => {
        button.addEventListener('click', (e) => {
          const key = e.currentTarget.dataset.preset;
          if (PRESETS[key]) {
            items = JSON.parse(JSON.stringify(PRESETS[key]));
            renderItems();
          }
        });
      });

      // Print / PDF Button
      document.getElementById('btn-print')?.addEventListener('click', () => {
        window.print();
      });

      // LocalStorage Draft Management
      const STORAGE_KEY_CURRENT = 'faza_ponuda_current';
      const STORAGE_KEY_SAVED = 'faza_ponude_saved';

      function getFormData() {
        return {
          issuerName: document.getElementById('issuer-name').value,
          issuerAddress: document.getElementById('issuer-address').value,
          issuerId: document.getElementById('issuer-id').value,
          issuerPhone: document.getElementById('issuer-phone').value,
          issuerEmail: document.getElementById('issuer-email').value,
          issuerWeb: document.getElementById('issuer-web').value,
          quoteTitle: document.getElementById('quote-title').value,
          quoteSubtitle: document.getElementById('quote-subtitle').value,
          clientName: document.getElementById('client-name').value,
          clientAddress: document.getElementById('client-address').value,
          clientId: document.getElementById('client-id').value,
          clientContact: document.getElementById('client-contact').value,
          quoteNumber: document.getElementById('quote-number').value,
          quoteDate: document.getElementById('quote-date').value,
          quotePlace: document.getElementById('quote-place').value,
          quoteValidity: document.getElementById('quote-validity').value,
          bankName: document.getElementById('bank-name').value,
          bankIban: document.getElementById('bank-iban').value,
          vatRate: document.getElementById('vat-rate-select').value,
          quoteTerms: document.getElementById('quote-terms').value,
          items: items
        };
      }

      function setFormData(data) {
        if (!data) return;
        if (data.issuerName !== undefined) document.getElementById('issuer-name').value = data.issuerName;
        if (data.issuerAddress !== undefined) document.getElementById('issuer-address').value = data.issuerAddress;
        if (data.issuerId !== undefined) document.getElementById('issuer-id').value = data.issuerId;
        if (data.issuerPhone !== undefined) document.getElementById('issuer-phone').value = data.issuerPhone;
        if (data.issuerEmail !== undefined) document.getElementById('issuer-email').value = data.issuerEmail;
        if (data.issuerWeb !== undefined) document.getElementById('issuer-web').value = data.issuerWeb;
        if (data.quoteTitle !== undefined) document.getElementById('quote-title').value = data.quoteTitle;
        if (data.quoteSubtitle !== undefined) document.getElementById('quote-subtitle').value = data.quoteSubtitle;
        if (data.clientName !== undefined) document.getElementById('client-name').value = data.clientName;
        if (data.clientAddress !== undefined) document.getElementById('client-address').value = data.clientAddress;
        if (data.clientId !== undefined) document.getElementById('client-id').value = data.clientId;
        if (data.clientContact !== undefined) document.getElementById('client-contact').value = data.clientContact;
        if (data.quoteNumber !== undefined) document.getElementById('quote-number').value = data.quoteNumber;
        if (data.quoteDate !== undefined) document.getElementById('quote-date').value = data.quoteDate;
        if (data.quotePlace !== undefined) document.getElementById('quote-place').value = data.quotePlace;
        if (data.quoteValidity !== undefined) document.getElementById('quote-validity').value = data.quoteValidity;
        if (data.bankName !== undefined) document.getElementById('bank-name').value = data.bankName;
        if (data.bankIban !== undefined) document.getElementById('bank-iban').value = data.bankIban;
        if (data.vatRate !== undefined) document.getElementById('vat-rate-select').value = data.vatRate;
        if (data.quoteTerms !== undefined) document.getElementById('quote-terms').value = data.quoteTerms;
        if (Array.isArray(data.items)) items = data.items;
        renderItems();
      }

      function saveToLocalStorageCurrent() {
        try {
          const data = getFormData();
          localStorage.setItem(STORAGE_KEY_CURRENT, JSON.stringify(data));
        } catch (e) {
          console.error(e);
        }
      }

      function loadFromLocalStorageCurrent() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY_CURRENT);
          if (raw) {
            const data = JSON.parse(raw);
            setFormData(data);
          }
        } catch (e) {
          console.error(e);
        }
      }

      // Saved quotes list
      function getSavedQuotes() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY_SAVED) || '[]');
        } catch (e) {
          return [];
        }
      }

      function updateSavedCount() {
        const list = getSavedQuotes();
        const el = document.getElementById('saved-count');
        if (el) el.innerText = list.length;
      }

      document.getElementById('btn-save-draft')?.addEventListener('click', () => {
        const qData = getFormData();
        const saved = getSavedQuotes();
        const title = prompt('Unesite naziv nacrta za spremanje:', `${qData.quoteNumber} - ${qData.clientName || 'Klijent'}`);
        if (title) {
          saved.unshift({
            id: Date.now(),
            title: title,
            date: new Date().toLocaleString('bs-BA'),
            data: qData
          });
          localStorage.setItem(STORAGE_KEY_SAVED, JSON.stringify(saved));
          updateSavedCount();
          alert('Ponuda uspješno sačuvana!');
        }
      });

      // Modal Saved Quotes logic
      const modal = document.getElementById('saved-modal');
      document.getElementById('btn-open-saved')?.addEventListener('click', () => {
        renderSavedList();
        modal.classList.add('active');
      });

      document.getElementById('btn-close-modal')?.addEventListener('click', () => {
        modal.classList.remove('active');
      });

      function renderSavedList() {
        const listContainer = document.getElementById('saved-quotes-list');
        if (!listContainer) return;
        const saved = getSavedQuotes();
        if (saved.length === 0) {
          listContainer.innerHTML = '<p style="color: #94a3b8; text-align: center;">Nemate sačuvanih ponuda.</p>';
          return;
        }

        listContainer.innerHTML = '';
        saved.forEach((item, index) => {
          const div = document.createElement('div');
          div.className = 'saved-quote-item';
          div.innerHTML = `
            <div>
              <strong style="color: #38bdf8;">${item.title}</strong>
              <div style="font-size: 0.75rem; color: #94a3b8;">${item.date}</div>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button type="button" class="btn-tool btn-primary btn-load-saved" data-index="${index}" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">Učitaj</button>
              <button type="button" class="btn-tool btn-danger btn-del-saved" data-index="${index}" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">✕</button>
            </div>
          `;
          listContainer.appendChild(div);
        });

        document.querySelectorAll('.btn-load-saved').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(e.target.dataset.index);
            const saved = getSavedQuotes();
            if (saved[idx]) {
              setFormData(saved[idx].data);
              modal.classList.remove('active');
            }
          });
        });

        document.querySelectorAll('.btn-del-saved').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt(e.target.dataset.index);
            const saved = getSavedQuotes();
            saved.splice(idx, 1);
            localStorage.setItem(STORAGE_KEY_SAVED, JSON.stringify(saved));
            updateSavedCount();
            renderSavedList();
          });
        });
      }

      // Reset button
      document.getElementById('btn-reset')?.addEventListener('click', () => {
        if (confirm('Da li ste sigurni da želite poništiti ponudu na početne vrijednosti?')) {
          localStorage.removeItem(STORAGE_KEY_CURRENT);
          location.reload();
        }
      });

      // Init on load
      loadFromLocalStorageCurrent();
      renderItems();
      updateSavedCount();
    </script>
  </body>
</html>
