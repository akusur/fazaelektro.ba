---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

const baseURL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="bs">
  <head>
    <BaseHead
      title={`Ponuda za elektroinstalacijske radove — ${SITE_TITLE}`}
      description="Predložak i kreiranje ponuda za elektroinstalacijske radove"
    />
    <style>
      :root {
        --paper-width: 210mm;
        --paper-min-height: 297mm;
        --accent-blue: #1d6dff;
        --accent-dark: #1249b5;
        --text-color: #1f2937;
        --border-color: #e5e7eb;
        --bg-preview: #eef2f6;
      }

      body {
        background-color: var(--bg-preview);
        color: var(--text-color);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Control Toolbar styling */
      .toolbar-container {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(12px);
        color: #fff;
        padding: 0.75rem 1.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .toolbar-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .toolbar-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
      }

      .toolbar-title span.badge {
        background: rgba(29, 109, 255, 0.3);
        color: #60a5fa;
        border: 1px solid rgba(96, 165, 250, 0.3);
        font-size: 0.75rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
      }

      .btn-tool {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .btn-tool.btn-primary {
        background: var(--accent-blue);
        color: white;
        box-shadow: 0 4px 12px rgba(29, 109, 255, 0.3);
      }
      .btn-tool.btn-primary:hover {
        background: var(--accent-dark);
      }

      .btn-tool.btn-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #f3f4f6;
        border-color: rgba(255, 255, 255, 0.2);
      }
      .btn-tool.btn-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
      }

      .btn-tool.btn-accent {
        background: #10b981;
        color: white;
      }
      .btn-tool.btn-accent:hover {
        background: #059669;
      }

      .btn-tool.btn-danger {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        border-color: rgba(239, 68, 68, 0.3);
      }
      .btn-tool.btn-danger:hover {
        background: rgba(239, 68, 68, 0.4);
        color: #fff;
      }

      .presets-dropdown {
        position: relative;
        display: inline-block;
      }

      .presets-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 105%;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 10px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        min-width: 320px;
        z-index: 105;
        overflow: hidden;
      }

      .presets-dropdown:hover .presets-menu,
      .presets-dropdown:focus-within .presets-menu {
        display: block;
      }

      .presets-item {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.75rem 1rem;
        background: none;
        border: none;
        border-bottom: 1px solid #334155;
        color: #e2e8f0;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      .presets-item:last-child {
        border-bottom: none;
      }
      .presets-item:hover {
        background: #334155;
        color: #38bdf8;
      }
      .presets-item strong {
        display: block;
        color: #fff;
        margin-bottom: 0.2rem;
      }

      /* Main Page Wrapper */
      .page-wrapper {
        padding: 2rem 1rem 4rem;
        display: flex;
        justify-content: center;
      }

      /* Printable A4 Paper Document */
      .paper {
        background: #ffffff;
        width: var(--paper-width);
        min-height: var(--paper-min-height);
        padding: 18mm 18mm 20mm 18mm;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), 0 1px 4px rgba(0, 0, 0, 0.05);
        border-radius: 2px;
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      /* Document Header */
      .doc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid var(--accent-blue);
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .doc-logo-area {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: 50%;
      }

      .doc-logo-img {
        max-height: 55px;
        width: auto;
        object-fit: contain;
      }

      .company-title-editable {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        line-height: 1.2;
      }

      .company-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .company-details-box {
        text-align: right;
        font-size: 0.825rem;
        color: #475569;
        line-height: 1.45;
      }

      /* Info Grid (Issuer vs Client & Offer Metadata) */
      .info-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1rem 1.2rem;
      }

      .info-card-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-dark);
        margin-bottom: 0.6rem;
        border-bottom: 1px dashed #cbd5e1;
        padding-bottom: 0.4rem;
      }

      .editable-field {
        width: 100%;
        border: 1px solid transparent;
        background: transparent;
        font-family: inherit;
        font-size: 0.875rem;
        color: #1e293b;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        transition: all 0.15s ease;
      }

      .editable-field:hover {
        background: rgba(29, 109, 255, 0.04);
        border-color: #cbd5e1;
      }

      .editable-field:focus {
        outline: none;
        background: #fff;
        border-color: var(--accent-blue);
        box-shadow: 0 0 0 2px rgba(29, 109, 255, 0.2);
      }

      textarea.editable-field {
        resize: vertical;
        min-height: 3rem;
      }

      .meta-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      .meta-table td {
        padding: 0.3rem 0;
        vertical-align: middle;
      }
      .meta-table td.label {
        font-weight: 600;
        color: #64748b;
        width: 45%;
      }

      /* Document Title & Description */
      .doc-title-section {
        margin-bottom: 1.25rem;
        text-align: center;
        background: #f1f5f9;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        border-left: 4px solid var(--accent-blue);
      }

      .doc-title-input {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .doc-note-input {
        font-size: 0.85rem;
        color: #475569;
        text-align: center;
        margin-top: 0.2rem;
      }

      /* Items Table */
      .items-table-container {
        margin-bottom: 1.5rem;
      }

      .items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }

      .items-table th {
        background: #1e293b;
        color: #ffffff;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 0.6rem 0.5rem;
        text-align: left;
        border: 1px solid #1e293b;
      }

      .items-table td {
        border: 1px solid #e2e8f0;
        padding: 0.4rem 0.5rem;
        vertical-align: top;
      }

      .items-table tbody tr:nth-child(even) {
        background: #f8fafc;
      }

      .col-num { width: 5%; text-align: center; font-weight: 600; color: #64748b; }
      .col-desc { width: 45%; }
      .col-unit { width: 10%; text-align: center; }
      .col-qty { width: 10%; text-align: right; }
      .col-price { width: 13%; text-align: right; }
      .col-disc { width: 7%; text-align: right; }
      .col-total { width: 14%; text-align: right; font-weight: 700; color: #0f172a; }
      .col-actions { width: 4%; text-align: center; }

      .text-center { text-align: center; }
      .text-right { text-align: right; }

      .btn-icon-danger {
        background: none;
        border: none;
        color: #ef4444;
        cursor: pointer;
        font-size: 1rem;
        padding: 0.2rem;
        border-radius: 4px;
        transition: background 0.15s ease;
      }
      .btn-icon-danger:hover {
        background: #fee2e2;
      }

      .add-row-bar {
        margin-top: 0.5rem;
        display: flex;
        gap: 0.5rem;
      }

      .btn-add-row {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #f1f5f9;
        color: var(--accent-dark);
        border: 1px dashed var(--accent-blue);
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
        justify-content: center;
      }

      .btn-add-row:hover {
        background: rgba(29, 109, 255, 0.08);
      }

      /* Calculation Summary Box */
      .summary-section {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .bank-info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.9rem 1.1rem;
        font-size: 0.825rem;
      }

      .bank-info-card h4 {
        margin: 0 0 0.5rem 0;
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #475569;
        letter-spacing: 0.05em;
      }

      .totals-card {
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.8rem 1rem;
      }

      .totals-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
      }

      .totals-table td {
        padding: 0.35rem 0;
      }

      .totals-table tr.total-row {
        border-top: 2px solid #0f172a;
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--accent-dark);
      }

      .totals-table tr.total-row td {
        padding-top: 0.6rem;
      }

      .words-total-box {
        margin-top: 0.6rem;
        font-size: 0.775rem;
        color: #475569;
        font-style: italic;
        background: #fff;
        padding: 0.4rem 0.6rem;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
      }

      /* Terms & Notes */
      .terms-section {
        margin-bottom: 2.5rem;
        border-top: 1px solid #e2e8f0;
        padding-top: 1rem;
      }

      .terms-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        margin-bottom: 0.5rem;
      }

      .terms-textarea {
        width: 100%;
        font-size: 0.825rem;
        color: #334155;
        line-height: 1.5;
        min-height: 4.5rem;
      }

      /* Signatures Section */
      .signatures-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-top: auto;
        padding-top: 1.5rem;
      }

      .signature-box {
        text-align: center;
        font-size: 0.825rem;
        color: #475569;
      }

      .signature-line {
        border-bottom: 1px solid #94a3b8;
        margin-bottom: 0.5rem;
        height: 45px;
      }

      /* Saved Quotes Drawer / Modal */
      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 200;
        align-items: center;
        justify-content: center;
      }

      .modal-backdrop.active {
        display: flex;
      }

      .modal-card {
        background: #1e293b;
        color: #fff;
        border-radius: 12px;
        width: 90%;
        max-width: 550px;
        max-height: 80vh;
        overflow-y: auto;
        padding: 1.5rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      }

      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
      }

      .modal-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
      }

      .saved-quote-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #334155;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
      }

      .only-print {
        display: none;
      }

      /* PRINT STYLES - CRITICAL FOR CLEAN A4 PDF OUTPUT */
      @media print {
        @page {
          size: A4 portrait;
          margin: 12mm 12mm 12mm 12mm;
        }

        html, body {
          background: #ffffff !important;
          color: #000000 !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }

        .no-print,
        .toolbar-container,
        .add-row-bar,
        .col-actions,
        .modal-backdrop {
          display: none !important;
        }

        .only-print {
          display: inline !important;
        }

        .page-wrapper {
          padding: 0 !important;
          margin: 0 !important;
          display: block !important;
        }

        .paper {
          box-shadow: none !important;
          width: 100% !important;
          min-height: auto !important;
          padding: 0 !important;
          margin: 0 !important;
          border-radius: 0 !important;
        }

        .editable-field {
          border: none !important;
          background: transparent !important;
          padding: 0 !important;
          box-shadow: none !important;
        }

        .editable-field:hover,
        .editable-field:focus {
          background: transparent !important;
          border-color: transparent !important;
          box-shadow: none !important;
        }

        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
          -webkit-appearance: none;
          margin: 0;
        }
        input[type="number"] {
          -moz-appearance: textfield;
        }

        .info-card,
        .bank-info-card,
        .totals-card,
        .doc-title-section {
          background: #fafafa !important;
          border-color: #d1d5db !important;
        }

        .items-table th {
          background: #111827 !important;
          color: #ffffff !important;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        .items-table td {
          border-color: #d1d5db !important;
        }

        .words-total-box {
          background: #fff !important;
          border-color: #e5e7eb !important;
        }

        .doc-header {
          border-bottom: 1px solid #4b5563 !important;
          padding-bottom: 5mm !important;
          margin-bottom: 7mm !important;
        }

        .company-title-editable,
        .company-subtitle,
        .doc-title-section,
        .terms-section {
          display: none !important;
        }

        .doc-logo-area {
          justify-content: center;
          min-height: 22mm;
        }

        .doc-logo-img {
          max-height: 18mm;
        }

        .company-details-box {
          font-size: 9pt !important;
          line-height: 1.25 !important;
        }

        .doc-print-title {
          display: block !important;
          margin: 8mm 0 10mm !important;
          color: #111827 !important;
          font-size: 17pt !important;
          font-weight: 700 !important;
          text-align: center !important;
        }

        .info-grid {
          gap: 12mm !important;
          margin-bottom: 8mm !important;
        }

        .info-card,
        .bank-info-card,
        .totals-card {
          padding: 0 !important;
          background: transparent !important;
          border: 0 !important;
          border-radius: 0 !important;
        }

        .info-card-title,
        .bank-info-card h4 {
          margin-bottom: 2mm !important;
          padding-bottom: 0 !important;
          color: #111827 !important;
          border: 0 !important;
          font-size: 8.5pt !important;
        }

        .meta-table,
        .editable-field,
        .items-table,
        .totals-table {
          font-size: 9pt !important;
        }

        .meta-table td {
          padding: 0 !important;
        }

        .items-table-container {
          margin-bottom: 8mm !important;
        }

        .items-table th {
          padding: 2mm 1mm !important;
          color: #111827 !important;
          background: transparent !important;
          border: 0 !important;
          border-top: 1px solid #9ca3af !important;
          border-bottom: 1px solid #9ca3af !important;
          font-size: 8.5pt !important;
        }

        .items-table td {
          padding: 1.5mm 1mm !important;
          background: transparent !important;
          border: 0 !important;
          border-bottom: 1px solid #e5e7eb !important;
        }

        .items-table tbody tr:nth-child(even) {
          background: transparent !important;
        }

        .summary-section {
          grid-template-columns: 1.2fr 0.8fr !important;
          gap: 12mm !important;
          margin-bottom: 10mm !important;
        }

        .totals-table tr.total-row {
          color: #111827 !important;
          font-size: 10pt !important;
        }

        .words-total-box {
          display: none !important;
        }

        .signatures-grid {
          margin-top: 0 !important;
          padding-top: 0 !important;
        }

        .signature-line {
          height: 12mm !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Action Toolbar (Hidden in Print) -->
    <div class="toolbar-container no-print">
      <div class="toolbar-inner">
        <div class="toolbar-title">
          <span>⚡ FAZA Ponude</span>
          <span class="badge">Static Generator v2.0</span>
        </div>

        <div class="toolbar-actions">
          <button type="button" class="btn-tool btn-primary" id="btn-print" title="Otvorite prozor za štampu ili spremanje u PDF">
            🖨️ Sačuvaj kao PDF / Printaj
          </button>

          <div class="presets-dropdown">
            <button type="button" class="btn-tool btn-secondary">
              ⚡ Brzi predlošci radova ▾
            </button>
            <div class="presets-menu">
              <button type="button" class="presets-item" data-preset="stan">
                <strong>Kompletna elektroinstalacija stana</strong>
                Štemanje, polaganje kablova, razvodni ormar, fina montaža i ispitivanje.
              </button>
              <button type="button" class="presets-item" data-preset="ormar">
                <strong>Razvodni ormar i osigurači</strong>
                Ugradnja ormara, FID sklopke, automatskih osigurača i šemiranje.
              </button>
              <button type="button" class="presets-item" data-preset="fina">
                <strong>Fina montaža utičnica i rasvjete</strong>
                Montaža šuko utičnica, prekidača, LED panela i ukrasne rasvjete.
              </button>
              <button type="button" class="presets-item" data-preset="gromobran">
                <strong>Gromobranska instalacija i uzemljenje</strong>
                FeZn traka, mjerni spojevi i mjerenje otpora uzemljenja.
              </button>
              <button type="button" class="presets-item" data-preset="prazno">
                <strong>Očisti sve (Prazan obrazac)</strong>
                Započni novu praznu ponudu.
              </button>
            </div>
          </div>

          <button type="button" class="btn-tool btn-accent" id="btn-save-draft" title="Spremi trenutnu ponudu u preglednik">
            💾 Sačuvaj nacrt
          </button>

          <button type="button" class="btn-tool btn-secondary" id="btn-open-saved" title="Pregledaj sačuvane ponude">
            📂 Moje ponude (<span id="saved-count">0</span>)
          </button>

          <button type="button" class="btn-tool btn-danger" id="btn-reset" title="Poništi na početne postavke">
            🔄 Resetuj
          </button>
        </div>
      </div>
    </div>

    <!-- Paper Container -->
    <div class="page-wrapper">
      <main class="paper" id="quote-document">

        <div>
          <!-- Document Header -->
          <header class="doc-header">
            <div class="doc-logo-area">
              <img src={`${baseURL}faza-logo.png`} alt="FAZA Logo" class="doc-logo-img" onerror="this.style.display='none'" />
              <div>
                <h1 class="company-title-editable">FAZA ELEKTROINSTALACIJE</h1>
                <div class="company-subtitle">Profesionalne elektroinstalacije i održavanje</div>
              </div>
            </div>

            <div class="company-details-box">
              <input type="text" id="issuer-name" class="editable-field text-right" style="font-weight: 700;" value="FAZA Elektroinstalacije d.o.o." />
              <input type="text" id="issuer-address" class="editable-field text-right" value="Ulica i broj, 71000 Sarajevo" />
